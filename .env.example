# ---------- Backend (required by the assignment) ----------
# Comma-separated key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
# Use keys from separate projects/accounts so their quotas are independent.
# Plain keys belong to the primary model's provider. Prefix a key with its provider
# to bind it to that provider's models, e.g. ...,groq:your_groq_key
LLM_API_KEYS=your_first_api_key,your_second_api_key
# SQLite location. In Docker this lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend origin).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook on POST /chat.
ENABLE_FAILURE_SIMULATION=true

# ---------- Backend (optional) ----------
# LiteLLM model string(s), primary first. Optional comma-separated backup model(s):
# when the primary model is overloaded (provider 503), every key is retried on the backup.
# Example: gemini/gemini-3.5-flash-lite,gemini/gemini-3.5-flash,groq/<groq-model>
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Leave empty to use the built-in default system prompt.
DEFAULT_SYSTEM_PROMPT=
# Per-attempt provider timeout, in seconds.
LLM_TIMEOUT_SECONDS=30
# LiteLLM in-memory cache TTL, in seconds (LiteLLM's own default is 600).
CACHE_TTL_SECONDS=86400

# ---------- Fallback: self-hosted Qwen (LM Studio via ngrok) ----------
# Used only after every key in LLM_API_KEYS failed. Leave any value empty to disable.
# e.g. FALLBACK_LLM_MODEL=openai/qwen/qwen3-14b, FALLBACK_LLM_API_BASE=https://<your-ngrok-domain>/v1
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_BASE=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_TIMEOUT_SECONDS=

# ---------- Frontend ----------
# Docker: backend URL the *browser* calls (written to /config.js at container start).
API_BASE_URL=http://localhost:8000
# Static hosting (Vercel/Netlify): set this at build time instead.
VITE_API_BASE_URL=http://localhost:8000
